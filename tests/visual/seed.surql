DEFINE TABLE person SCHEMAFULL;
DEFINE FIELD name ON person TYPE string;
DEFINE FIELD email ON person TYPE string;
DEFINE FIELD joined ON person TYPE datetime;
DEFINE FIELD location ON person TYPE option<geometry<point>>;
DEFINE INDEX person_email ON person FIELDS email UNIQUE;
DEFINE TABLE project SCHEMAFULL;
DEFINE FIELD title ON project TYPE string;
DEFINE FIELD stars ON project TYPE int;
DEFINE FIELD tags ON project TYPE array<string>;
DEFINE TABLE works_on TYPE RELATION IN person OUT project;
DEFINE FIELD role ON works_on TYPE string;
DEFINE TABLE knows TYPE RELATION IN person OUT person;
DEFINE EVENT project_starred ON project WHEN $event = "UPDATE" THEN { CREATE audit SET at = time::now(), project = $after.id };
CREATE person:ada SET name = "Ada", email = "ada@example.com", joined = d"2024-03-01T09:00:00Z", location = (-0.1276, 51.5072);
CREATE person:grace SET name = "Grace", email = "grace@example.com", joined = d"2024-05-12T09:00:00Z", location = (-77.0369, 38.9072);
CREATE person:alan SET name = "Alan", email = "alan@example.com", joined = d"2025-01-20T09:00:00Z", location = (-2.2426, 53.4808);
CREATE project:rrflow SET title = "RRFlow", stars = 1200, tags = ["engine", "rust"];
CREATE project:connectome SET title = "Connectome", stars = 640, tags = ["ui", "tauri"];
INSERT RELATION INTO works_on { id: works_on:ada_rrflow, in: person:ada, out: project:rrflow, role: "lead" };
INSERT RELATION INTO works_on { id: works_on:grace_rrflow, in: person:grace, out: project:rrflow, role: "storage" };
INSERT RELATION INTO works_on { id: works_on:alan_connectome, in: person:alan, out: project:connectome, role: "design" };
INSERT RELATION INTO works_on { id: works_on:ada_connectome, in: person:ada, out: project:connectome, role: "review" };
INSERT RELATION INTO knows { id: knows:ada_grace, in: person:ada, out: person:grace };
INSERT RELATION INTO knows { id: knows:grace_alan, in: person:grace, out: person:alan };
DEFINE PARAM $team VALUE "core";
DEFINE FUNCTION fn::greet($name: string) { RETURN "Hello " + $name; };
DEFINE USER demo ON DATABASE PASSWORD "not-a-secret" ROLES VIEWER;
SELECT *, ->works_on->project AS projects FROM person;
